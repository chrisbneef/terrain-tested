---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Strip from '../../components/Strip.astro';
import Close from '../../components/Close.astro';
import { site, baseUrl } from '../../site.config.mjs';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, answer, published, updated } = note.data;
const url = `${baseUrl}/field-notes/${note.id}/`;
const author = site.dealerName ?? site.name;
const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (date: Date) => date.toISOString().slice(0, 10);

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: title,
    description,
    datePublished: iso(published),
    dateModified: iso(updated),
    author: site.dealerName ? { '@id': `${baseUrl}/#dealer` } : { '@id': `${baseUrl}/#business` },
    publisher: { '@id': `${baseUrl}/#business` },
    mainEntityOfPage: url,
    inLanguage: 'en-US',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${baseUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Field Notes', item: `${baseUrl}/field-notes/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={`${title} | ${site.shortName}`} description={description} schema={schema} ogType="article">
  <article>
    <Strip
      title={title}
      crumbs={[{ href: '/field-notes/', label: 'Field Notes' }]}
    />
    <div class="section">
      <div class="wrap">
        <p class="byline">
          By <a href="/about/">{author}</a>, independent AMSOIL Dealer in {site.city}, {
            site.regionName
          }. Published <time datetime={iso(published)}>{fmt(published)}</time>
          {iso(updated) !== iso(published) && (
            <>
              , updated <time datetime={iso(updated)}>{fmt(updated)}</time>
            </>
          )}.
        </p>
        <p class="answer"><strong>Short answer:</strong> {answer}</p>
        <div class="prose" style="margin-top:2rem">
          <Content />
        </div>
        <aside class="about-author">
          <h2 style="font-size:1.3rem">Who wrote this</h2>
          <p style="margin-top:.6rem">
            {author} is an independent AMSOIL Dealer in {site.city}, {site.regionName}, with more
            than a decade as a heavy equipment operator, experience as a mechanic across most
            machine types, a marine engine certification, and years in off-road and motocross
            racing. <a href="/about/">More about the dealer</a>.
          </p>
          <p>
            Always follow the specifications in your owner’s or service manual. This article is
            general education, not a substitute for the manufacturer’s requirements.
          </p>
        </aside>
      </div>
    </div>
  </article>

  <Close />
</Base>
