---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Strip from '../../components/Strip.astro';
import Close from '../../components/Close.astro';
import { applications } from '../../data/applications.mjs';
import { site, baseUrl } from '../../site.config.mjs';

export function getStaticPaths() {
  return applications.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const notes = await getCollection('notes');
const noteTitle = (id: string) => notes.find((note) => note.id === id)?.data.title;
const url = `${baseUrl}/applications/${app.slug}/`;
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/amsoil/*.jpg', { eager: true });
const img = (name: string) => files[`../../assets/amsoil/${name}.jpg`].default;

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: `${app.name} lubricant recommendations`,
    serviceType: 'Lubricant selection and product guidance',
    description: app.description,
    provider: { '@id': `${baseUrl}/#business` },
    areaServed: { '@type': 'City', name: `${site.city}, ${site.regionName}` },
    url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${baseUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Applications', item: `${baseUrl}/applications/` },
      { '@type': 'ListItem', position: 3, name: app.name, item: url },
    ],
  },
];
---

<Base title={`${app.title} | ${site.shortName}`} description={app.description} schema={schema}>
  <Strip
    title={app.title}
    intro={app.lede}
    crumbs={[
      { href: '/applications/', label: 'Applications' },
      { href: `/applications/${app.slug}/`, label: app.name },
    ]}
  />

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>What this work does to oil</h2>
        <p class="lead">{app.summary}</p>
        <p class="collar" style="color:var(--contour-ink)">{app.machines}</p>
      </div>
      <dl class="conditions">
        {
          app.conditions.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--woodland">
    <div class="wrap">
      <h2>Questions I hear about {app.name.toLowerCase()}</h2>
      <div class="questions">
        {
          app.questions.map((item) => (
            <div>
              <h3>{item.q}</h3>
              <p>{item.a}</p>
              {item.note && noteTitle(item.note) && (
                <p>
                  <a class="more" href={`/field-notes/${item.note}/`}>
                    {noteTitle(item.note)}
                  </a>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What I point people to for {app.name.toLowerCase()}</h2>
      <p class="lead">
        A starting point, not a prescription. The right product depends on the specification in
        your manual and how you use the machine, so ask me before you buy.
      </p>
      <div class="shelf">
        <figure class="shelf-ad">
          <a href="/contact/">
            <Image src={img(app.ad.image)} alt={app.ad.alt} widths={[420, 840]} sizes="(min-width: 56rem) 24rem, 90vw" />
          </a>
          <figcaption>Official AMSOIL artwork for independent dealers.</figcaption>
        </figure>
        <ul class="products">
          {
            app.products.map((product) => (
              <li>
                <span class="plate">
                  <Image src={img(product.image)} alt={`${product.name} package`} height={320} />
                </span>
                <div>
                  <h3>{product.name}</h3>
                  <p>{product.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Close />
</Base>
